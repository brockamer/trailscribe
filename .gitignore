# Dependency directories
node_modules/
.pnpm-store/

# Build output
dist/
coverage/

# Environment files
.env
.env.local
.env.*

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log\*

# OS metadata
.DS_Store
Thumbs.db

# Derived PDF text extracts (regenerable via pdftotext)
materials/*.txt

# Wrangler local dev
.dev.vars
.wrangler/

# Personal Claude Code config (not shared with team)
CLAUDE.local.md
.claude/

# Session-handoff prompts (ephemeral, regenerated by /jared-wrap)
tmp/


# Jared session locks (machine-local, written by /jared-start).
# Not merely untidy: jared performs no PID-liveness check, so a committed
# lock reads as a live session on every fresh clone and blocks /jared-start
# (REFUSE_BLEG) until cleared by hand. Tracked upstream as jared #376, which
# proposes relocating the locks inside the git dir; drop this entry if that ships.
.jared/
